.sidebar-user-panel{margin-top:auto;padding-top:14px}
.sidebar-user-card{position:relative;display:flex;align-items:center;gap:14px;padding:16px 18px;border-radius:24px;background:linear-gradient(145deg,#ffffff 0%,#f4fafe 100%);border:1px solid #cfe0ec;box-shadow:0 16px 34px rgba(20,70,105,.10);overflow:hidden}
.sidebar-user-card::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at top right,rgba(17,158,207,.14),transparent 42%);pointer-events:none}
.sidebar-user-avatar{position:relative;z-index:1;width:56px;height:56px;border-radius:18px;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,#9bc6e7 0%,#5ba9db 100%);color:#fff;box-shadow:0 10px 22px rgba(28,106,149,.22);flex-shrink:0}
