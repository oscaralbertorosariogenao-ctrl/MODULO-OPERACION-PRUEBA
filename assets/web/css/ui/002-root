/* UI-only theme overrides · Fase 3: aliases a Design System oficial */
:root{
  --bg:var(--go-color-bg);
  --panel:var(--go-color-surface);
  --line:var(--go-color-border);
  --line-soft:var(--go-color-surface-subtle);
  --text:var(--go-color-text);
  --text-soft:var(--go-color-text-muted);
  --title:var(--go-brand-blue);
  --title-dark:var(--go-color-text-strong);
  --primary:var(--go-brand-blue);
  --primary-dark:var(--go-brand-navy);
  --primary-dark-hover:var(--go-brand-navy-800);
  --green:var(--go-color-success);
  --green-dark:#126f45;
  --red:var(--go-color-danger);
  --shadow:var(--go-shadow-subtle);
}
body{background:var(--go-color-bg);}
.sidebar{
  background:linear-gradient(180deg,#ffffff 0%,#f6fbff 100%);
  border-right:1px solid #d9e7f1;
  box-shadow:0 12px 28px rgba(20,70,105,.08);
}
.sidebar h2{display:none;}
.brand-wrap{display:flex;flex-direction:column;align-items:center;gap:8px;padding:10px 8px 16px;margin-bottom:10px;border-bottom:1px solid var(--line-soft);}
.brand-logo{width:118px;height:62px;object-fit:contain;filter:drop-shadow(0 10px 16px rgba(17,158,207,.16));}.brand-logo-shell{width:148px;height:84px;border-radius:24px;background:linear-gradient(180deg,#ffffff 0%,#f2fbff 100%);display:grid;place-items:center;border:1px solid #d8edf5;box-shadow:0 14px 28px rgba(17,158,207,.10);padding:10px 12px;}
.brand-title{font-size:22px;font-weight:900;color:#119ecf;letter-spacing:.08em;line-height:1;}
.brand-subtitle{font-size:11px;font-weight:800;color:#6f8ca3;letter-spacing:.14em;text-transform:uppercase;}
.sidebar{width:320px;padding:18px 16px 20px;overflow-y:auto;overflow-x:hidden;position:sticky;top:0;height:100vh;display:flex;flex-direction:column;gap:12px}
.brand-wrap{gap:10px;padding:12px 10px 18px;margin-bottom:16px}
.brand-title{font-size:24px;letter-spacing:.06em}
.brand-subtitle{font-size:11px;letter-spacing:.18em;line-height:1.45;text-align:center;max-width:210px}
.sidebar-nav{display:flex;flex-direction:column;gap:12px;flex:1}
.sidebar-group{background:rgba(255,255,255,.72);border:1px solid #d8e7f1;border-radius:20px;padding:8px;box-shadow:0 8px 22px rgba(20,70,105,.05)}
.sidebar-group.sidebar-group-terminal{margin-top:10px;position:relative}
.sidebar-group.sidebar-group-terminal::before{content:"";position:absolute;left:16px;right:16px;top:-11px;height:1px;background:linear-gradient(90deg,rgba(111,140,163,0),rgba(111,140,163,.45),rgba(111,140,163,0));}
.sidebar-group-btn{width:100%;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 14px;border:none;background:transparent;border-radius:16px;cursor:pointer;color:#32556f;font-size:14px;font-weight:900;letter-spacing:.04em;text-transform:uppercase}
.sidebar-group-btn:hover{background:#eef7fc}
.sidebar-group-main{display:flex;align-items:center;gap:12px;text-align:left}
.sidebar-group-main i{width:18px;text-align:center;color:#179ec9;font-size:15px}
.sidebar-group-arrow{color:#6f8ca3;font-size:13px;transition:transform .2s ease}
.sidebar-group.is-open .sidebar-group-arrow{transform:rotate(180deg)}
.sidebar-group-menu{display:grid;gap:6px;max-height:0;overflow:hidden;opacity:0;padding:0 6px;transition:max-height .25s ease, opacity .2s ease, padding .2s ease}
.sidebar-group.is-open .sidebar-group-menu{max-height:900px;opacity:1;padding:4px 6px 8px}
.sidebar-link{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;text-decoration:none;color:#506a80;font-size:14px;font-weight:700;cursor:pointer;transition:all .18s ease}
.sidebar-link i{width:18px;text-align:center;color:#708aa0;font-size:14px}
.sidebar-link:hover{background:#eef7fc;color:#179ec9;transform:translateX(2px)}
.sidebar-link:hover i{color:#179ec9}
.sidebar-link.active{background:linear-gradient(90deg,#e8f8fd 0%,#dff4fb 100%);color:#148fbc;box-shadow:inset 0 0 0 1px #cfeaf4}
