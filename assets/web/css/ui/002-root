/* ===== Modal Crear / Editar Operación · UI empresarial ===== */
.ops-modal-backdrop{
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at 20% 12%,rgba(34,180,226,.18),transparent 28%),
    radial-gradient(circle at 82% 18%,rgba(26,79,125,.18),transparent 30%),
    rgba(7,22,36,.48);
  backdrop-filter:blur(7px);
  display:flex;
  align-items:flex-start;
  justify-content:center;
  padding:22px;
  z-index:200;
  overflow:auto;
}

.ops-modal{
  width:min(1080px,calc(100vw - 38px));
  max-width:1080px;
  max-height:calc(100vh - 44px);
  background:linear-gradient(180deg,#f8fcff 0%,#eef7fc 100%);
  border-radius:32px;
  border:1px solid rgba(185,219,236,.95);
  box-shadow:0 34px 90px rgba(5,31,52,.32);
  overflow:hidden;
  display:flex;
  flex-direction:column;
  position:relative;
}

.ops-modal:before{
  content:'';
  position:absolute;
  inset:0 0 auto 0;
  height:150px;
  background:
    radial-gradient(circle at 88% 8%,rgba(39,190,225,.28),transparent 32%),
    linear-gradient(135deg,rgba(255,255,255,.82) 0%,rgba(232,248,255,.86) 48%,rgba(213,241,250,.72) 100%);
  pointer-events:none;
}

.ops-modal .modal-header{
  position:sticky;
  top:0;
  z-index:8;
  padding:22px 26px 20px;
  border-bottom:1px solid rgba(188,219,235,.95);
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  background:
    radial-gradient(circle at 92% 10%,rgba(31,184,225,.20),transparent 30%),
