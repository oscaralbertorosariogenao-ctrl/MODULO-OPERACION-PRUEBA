/* LOTEKA v220 · Inventario > Almacenes visual seguro
   Mejora SOLO visual. Conserva IDs, tablas, renderAlmacenes(), verDetalleAlmacen(), productos y flujos originales. */
#vista-almacenes{position:relative;}
#vista-almacenes > .header{
  position:relative; overflow:hidden; align-items:center; gap:16px; margin-bottom:18px;
  padding:22px 24px; border-radius:26px; color:#fff;
  background:linear-gradient(135deg,rgba(8,35,61,.98),rgba(8,84,139,.94));
  border:1px solid rgba(125,211,252,.22);
  box-shadow:0 22px 55px rgba(2,12,27,.26);
}
#vista-almacenes > .header:before{content:"";position:absolute;right:-85px;top:-120px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(56,189,248,.30),transparent 64%);pointer-events:none;}
#vista-almacenes > .header:after{content:"";position:absolute;left:-100px;bottom:-150px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.24),transparent 66%);pointer-events:none;}
#vista-almacenes > .header h2{position:relative;z-index:1;margin:0;color:#fff;font-size:30px;font-weight:1000;letter-spacing:-.6px;}
#vista-almacenes > .header h2:before{content:"Centro Logístico Grupo Ortiz";display:block;width:max-content;max-width:100%;margin-bottom:8px;padding:7px 11px;border-radius:999px;background:rgba(255,255,255,.11);border:1px solid rgba(255,255,255,.16);color:#bfe8ff;font-size:12px;font-weight:950;letter-spacing:.45px;text-transform:uppercase;}
#vista-almacenes > .header h2:after{content:"Control central de almacenes, productos y movimientos internos.";display:block;margin-top:7px;color:#cfe8f7;font-size:14px;font-weight:750;letter-spacing:0;}
#vista-almacenes > .header .btn{position:relative;z-index:1;border:0;border-radius:16px;padding:12px 16px;background:linear-gradient(135deg,#0ea5e9,#2563eb);color:#fff;font-weight:950;box-shadow:0 14px 30px rgba(14,165,233,.28);}
#vista-almacenes > .dashboard-cards{grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:18px 0;}
#vista-almacenes > .dashboard-cards .dashboard-card{position:relative;overflow:hidden;border-radius:22px;border:1px solid rgba(14,165,233,.20);background:linear-gradient(180deg,var(--card-bg,#fff),rgba(248,252,255,.96));box-shadow:0 18px 38px rgba(7,54,84,.08);padding:18px;}
#vista-almacenes > .dashboard-cards .dashboard-card:before{content:"";position:absolute;right:-55px;top:-70px;width:155px;height:155px;border-radius:50%;background:radial-gradient(circle,rgba(14,165,233,.18),transparent 68%);}
#vista-almacenes .dashboard-card-label{font-size:12px;text-transform:uppercase;letter-spacing:.35px;font-weight:1000;color:var(--text-muted,#64748b);}
#vista-almacenes .dashboard-card-value{font-size:32px;font-weight:1000;color:var(--text-main,#083b5d);margin-top:7px;}
#vista-almacenes .dashboard-card-sub{font-weight:800;color:var(--text-muted,#64748b);}
#vista-almacenes > .card-table{position:relative;overflow:hidden;border-radius:24px;border:1px solid rgba(14,165,233,.18);box-shadow:0 18px 40px rgba(7,54,84,.08);background:var(--card-bg,#fff);}
#vista-almacenes > .card-table:before{content:"Almacenes registrados";display:block;padding:16px 18px;border-bottom:1px solid rgba(14,165,233,.14);font-size:17px;font-weight:1000;color:var(--text-main,#083b5d);background:linear-gradient(90deg,rgba(14,165,233,.08),transparent);}
#vista-almacenes table thead th{font-size:12px;text-transform:uppercase;letter-spacing:.35px;font-weight:1000;}
#vista-almacenes #tabla-almacenes tr{transition:.16s transform,.16s background,.16s box-shadow;}
#vista-almacenes #tabla-almacenes tr:hover{background:rgba(14,165,233,.07);transform:translateX(2px);}
#vista-almacenes #tabla-almacenes td:first-child{font-weight:950;color:var(--text-main,#083b5d);}
#vista-almacenes #tabla-almacenes td:nth-child(2){font-weight:850;color:#0e7490;}
#vista-almacenes #tabla-almacenes .actions i{width:34px;height:34px;border-radius:12px;display:inline-grid;place-items:center;margin:0 3px;background:rgba(14,165,233,.12);color:#0284c7;cursor:pointer;transition:.16s;}
#vista-almacenes #tabla-almacenes .actions i:hover{transform:translateY(-1px);background:linear-gradient(135deg,#0ea5e9,#2563eb);color:#fff;}
body.dark-mode #vista-almacenes > .dashboard-cards .dashboard-card,
body.dark-mode #vista-almacenes > .card-table{background:#0f2035;border-color:rgba(148,163,184,.18);box-shadow:0 18px 40px rgba(0,0,0,.24);}
body.dark-mode #vista-almacenes .dashboard-card-value,
body.dark-mode #vista-almacenes > .card-table:before,
body.dark-mode #vista-almacenes #tabla-almacenes td:first-child{color:#eaf7ff;}
body.dark-mode #vista-almacenes .dashboard-card-label,
body.dark-mode #vista-almacenes .dashboard-card-sub{color:#9fb8ca;}
body.dark-mode #vista-almacenes #tabla-almacenes tr:hover{background:rgba(56,189,248,.08);}
@media(max-width:700px){#vista-almacenes > .header{padding:18px;border-radius:22px;align-items:flex-start;flex-direction:column;}#vista-almacenes > .header h2{font-size:25px;}#vista-almacenes > .dashboard-cards{grid-template-columns:1fr;}#vista-almacenes > .card-table{overflow-x:auto;}}

