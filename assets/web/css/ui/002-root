
:root{
  --bg:#f3f5f7;
  --panel:#ffffff;
  --line:#dfe5eb;
  --line-soft:#edf1f5;
  --text:#33485c;
  --text-soft:#76889a;
  --title:#2b7fc3;
  --title-dark:#304c67;
  --primary:#2f8fe8;
  --primary-dark:#5f7f92;
  --primary-dark-hover:#536f80;
  --green:#77b248;
  --green-dark:#5f9934;
  --red:#d9413a;
  --shadow:0 2px 10px rgba(37,56,88,.05);
}
*{margin:0;padding:0;box-sizing:border-box;font-family:"Segoe UI",Tahoma,Arial,sans-serif}
body{display:flex;background:var(--bg);color:var(--text)}
.sidebar{width:280px;background:#fff;padding:18px 16px;min-height:100vh;border-right:1px solid var(--line);box-shadow:var(--shadow)}
.sidebar h2{margin-bottom:14px;font-size:15px;font-weight:800;letter-spacing:.3px;color:#1f2f3d;text-transform:uppercase}
.menu-section-title{margin:18px 0 10px;font-size:13px;font-weight:800;letter-spacing:.4px;color:#7c8d9d;text-transform:uppercase;padding:0 8px}
.menu{display:flex;flex-direction:column;gap:6px}
.menu a{padding:12px 14px;border-radius:14px;text-decoration:none;color:#5b6977;display:flex;gap:10px;align-items:center;cursor:pointer;font-size:15px;font-weight:500;transition:all .18s ease}
.menu a:hover{background:#f1f5f8;color:var(--title)}
.menu a.active{background:#e9eef2;color:var(--title);font-weight:700}
.content{flex:1;padding:18px 18px 24px;overflow:auto}
.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;padding:0 2px}
.header h2,.entry-title{font-size:19px;font-weight:700;color:var(--title);letter-spacing:.1px}
.btn,.btn-entry,.btn-secondary,.btn-apply,.entry-mini-btn{border:none;cursor:pointer;font-weight:600;transition:all .18s ease}
.btn,.btn-entry{background:var(--primary-dark);color:#fff;padding:10px 16px;border-radius:4px;box-shadow:none}
.btn:hover,.btn-entry:hover,.btn-secondary:hover{background:var(--primary-dark-hover)}
.card-table,.entry-table-card,.filter-card,.dashboard-card,.detail-panel{background:var(--panel);border:1px solid var(--line);border-radius:12px;box-shadow:none}
.card-table,.entry-table-card{overflow:hidden}
table{width:100%;border-collapse:collapse}
th,td{padding:14px 14px;text-align:left;border-bottom:1px solid var(--line-soft);vertical-align:middle}
th{font-size:13px;font-weight:700;color:var(--title-dark);background:#fbfcfd}
td{font-size:14px;color:var(--text)}
img.product-thumb{width:58px;height:58px;border-radius:6px;object-fit:cover;background:#f4f6f8;border:1px solid var(--line-soft);padding:4px}
.actions i{cursor:pointer;margin-right:12px;font-size:15px;color:#6b8398}
.actions i:hover{color:var(--title)}
.actions i:last-child{margin-right:0}
.modal{position:fixed;inset:0;background:rgba(16,32,52,.28);display:none;justify-content:center;align-items:center;z-index:50;padding:16px}
.modal-content{background:#fff;width:700px;max-width:100%;padding:20px 20px 18px;border-radius:6px;max-height:95vh;overflow:auto;border:1px solid #cfd8e1;box-shadow:0 12px 30px rgba(23,42,66,.14)}
.modal-content.large{width:1200px}
.modal-content.xl{width:1080px;max-width:calc(100vw - 40px)}
.close{cursor:pointer;font-size:30px;color:#8ba0b2;font-weight:300;line-height:1}
.close:hover{color:#587189}
input,textarea,select{width:100%;padding:9px 12px;margin-bottom:12px;border-radius:3px;border:1px solid #c7d2dc;font-size:14px;background:#fff;color:var(--text)}
input:focus,textarea:focus,select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 2px rgba(47,143,232,.08)}
select{appearance:none;-webkit-appearance:none;-moz-appearance:none}
textarea{resize:vertical;min-height:90px}
.upload{border:1px solid #d9e2ea;height:275px;display:flex;align-items:center;justify-content:center;margin-bottom:12px;color:#8c9bab;border-radius:2px;overflow:hidden;background:#fbfcfd}
.hidden{display:none !important}
.small-muted{font-size:13px;color:#7b8d9d}

.detail-top{text-align:left;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line-soft)}
.detail-top h2{font-size:18px;font-weight:700;font-style:normal;letter-spacing:0;color:var(--title)}
.detail-grid{display:grid;grid-template-columns:1fr;gap:16px;align-items:start;margin:8px 0 14px}
.detail-left{padding:4px 2px 0}
.detail-left h3{font-size:14px;font-weight:700;color:var(--title);font-style:normal;margin-bottom:8px}
.detail-left p{font-size:14px;font-weight:600;font-style:normal;color:#495d70;margin-bottom:10px}
.stats{color:#9aa8b4;font-style:normal;font-weight:500;font-size:14px;line-height:1.5}
.search-box{border:1px solid var(--line);border-radius:3px;padding:9px 12px;margin-bottom:10px;display:flex;align-items:center;gap:10px;background:#fff}
.search-box i{color:#b1bfcb}
.search-box input{margin:0;border:none;outline:none;padding:0;font-size:14px;background:transparent}
.tab-buttons{display:flex;gap:0;margin-bottom:10px}
.tab-btn{background:#eef3f7;color:#7b95ab;border:none;padding:9px 18px;border-radius:0;font-size:13px;font-weight:700;font-style:normal;cursor:pointer;border:1px solid var(--line);border-bottom:none}
.tab-btn:first-child{border-radius:4px 4px 0 0}
.tab-btn.active,.tab-btn:not(.inactive){background:#6f97bd;color:#fff}
.tab-btn.inactive{opacity:1;background:#f3f6f9;color:#7c97ae}
.detail-panel{padding:14px;border-radius:8px}
.detail-section-title{text-align:center;font-size:16px;font-weight:700;font-style:normal;color:#9aa8b4;margin:8px 0 12px}
.detail-table th{font-size:13px;font-style:normal;font-weight:700;color:var(--title-dark);background:#f7f9fb}
.detail-table td{font-size:14px;font-weight:500;color:var(--text)}
.footer-actions{display:flex;justify-content:flex-end;margin-top:14px}
.btn-secondary{background:#6f97bd;color:#fff;padding:10px 18px;border-radius:4px}
.dashboard-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin:0 0 16px}
.dashboard-card{padding:16px 18px}
.dashboard-card-label{font-size:13px;font-weight:600;color:#8b99a6;margin-bottom:8px}
.dashboard-card-value{font-size:28px;font-weight:700;color:var(--title-dark);line-height:1}
.dashboard-card-sub{margin-top:6px;font-size:12px;color:#97a4b0}
.filter-card{padding:14px 14px 16px;margin-bottom:16px}
.filter-title{font-size:13px;font-weight:700;font-style:italic;color:#9aa8b4;margin-bottom:12px;letter-spacing:.2px;text-transform:uppercase}
.filter-grid{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:12px 14px}
.field-group label,.form-group label{display:block;font-size:12px;font-weight:600;color:#516477;margin-bottom:6px}
.select-wrap,.date-wrap{position:relative}
.select-wrap select,.date-wrap input{padding-right:42px;margin-bottom:0}
.select-wrap i,.date-wrap i{position:absolute;right:0;top:0;height:100%;width:34px;border-left:1px solid #cfd8e1;display:flex;align-items:center;justify-content:center;background:var(--primary);color:#fff;border-radius:0 3px 3px 0;pointer-events:none;font-size:13px}
.field-group select,.field-group input[type='date']{cursor:pointer}
.filter-actions{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-top:14px}
.btn-outline{background:#fff;color:#6d8091;border:1px solid #8ea1b1;padding:10px 14px;border-radius:3px;font-weight:500;cursor:pointer}
.btn-apply{background:var(--primary);color:#fff;padding:10px 14px;border-radius:3px;font-weight:600}
.entry-table-top{display:flex;justify-content:flex-end;padding:12px 14px 0}
.entry-search{width:210px;position:relative}
.entry-search input{margin:0;padding-left:36px;background:#fff;border-radius:3px}
.entry-search i{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a5b4}
.entry-empty{padding:26px;text-align:center;color:#98a5b2;font-style:normal;font-weight:500}
.sort-muted{color:#b8c1c9;font-size:11px;margin-left:4px}
.status-badge{display:inline-block;background:var(--green);color:#fff;padding:4px 9px;border-radius:4px;font-size:11px;font-weight:700;text-transform:lowercase}
.status-badge.red{background:var(--red)}
.entry-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.form-group{display:flex;flex-direction:column;gap:6px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:9px 12px;border:1px solid #c7d2dc;border-radius:3px;background:#fff;font-size:14px}
.form-group textarea{min-height:90px;resize:vertical}
.form-group.full{grid-column:1 / -1}
.form-group input[readonly]{background:#f4f7fa;color:#657789}
.entry-builder-card{margin-top:16px;border:1px solid #dfe5eb;border-radius:8px;padding:14px;background:#fbfcfd}
.entry-builder-title{font-size:13px;font-weight:700;color:#3c5368;margin-bottom:12px}
.entry-builder-grid{display:grid;grid-template-columns:1.1fr .9fr .9fr auto;gap:12px;align-items:end}
.serial-block{margin-top:12px;display:grid;grid-template-columns:1fr 320px;gap:14px}
.serial-input-row{display:flex;gap:10px}
.serial-chip-empty,.entry-items-empty{padding:16px;border:1px dashed #d5dde6;border-radius:8px;color:#7b8794;background:#fff;text-align:center;font-style:normal}
.serial-list-table,.entry-items-table{width:100%;background:#fff;border:1px solid #e3e9ef;border-radius:8px;overflow:hidden;border-collapse:collapse}
.serial-list-table th,.serial-list-table td,.entry-items-table th,.entry-items-table td{padding:10px 12px;border-bottom:1px solid #edf1f5;text-align:left}
.serial-list-table th,.entry-items-table th{background:#f6f8fa;font-size:12px;color:#617486;text-transform:uppercase}
.entry-mini-btn{background:var(--primary);color:#fff;padding:10px 14px;border-radius:4px}
.entry-remove-btn{background:none;border:none;color:#d33;font-size:16px;cursor:pointer}
.serial-hidden{display:none}

/* product detail visual cards */
.product-detail-head{display:flex;gap:18px;align-items:flex-start;padding-bottom:12px;border-bottom:1px solid var(--line-soft);margin-bottom:14px}
.product-detail-head img{width:92px;height:92px;border-radius:8px;object-fit:contain;background:#fff;border:1px solid var(--line);padding:6px}
.product-detail-meta h3{font-size:20px;color:var(--title-dark);margin-bottom:6px}
.product-detail-meta p{font-size:14px;color:#667789;margin:2px 0}
.product-serial-list{background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden}
.product-serial-list th{background:#f7f9fb}

@media (max-width:1100px){.detail-grid{grid-template-columns:1fr}}
@media (max-width:980px){.entry-builder-grid{grid-template-columns:1fr 1fr}.serial-block{grid-template-columns:1fr}}
@media (max-width:900px){.filter-grid{grid-template-columns:1fr 1fr}.filter-actions{grid-template-columns:1fr}.entry-table-top{justify-content:stretch}.entry-search{width:100%}}

.agency-tabs{display:flex;gap:0;margin-bottom:12px;flex-wrap:wrap}
.agency-tab{background:var(--primary-dark);color:#fff;padding:10px 16px;border:none;cursor:pointer;font-weight:600;font-size:14px}
.agency-tab:first-child{border-radius:4px 0 0 4px}
.agency-tab:last-child{border-radius:0 4px 4px 0}
.agency-tab.active{background:#486575}
.agency-toolbar{display:flex;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:14px;flex-wrap:wrap}
.agency-search-box{min-width:360px;max-width:520px;flex:1}
.agency-search-box label{display:block;font-weight:700;font-size:13px;color:#805c35;margin-bottom:6px}
.agency-quick{display:flex}
.agency-quick .search-icon-left{width:38px;display:flex;align-items:center;justify-content:center;border:1px solid var(--line);border-right:none;border-radius:4px 0 0 4px;background:#f2f5f8;color:#7d8c99}
.agency-quick input{margin:0;border-radius:0;height:38px}
.agency-quick button{border-radius:0 4px 4px 0;padding:0 18px;height:38px}
.agency-modal-top{margin-bottom:14px}
.agency-meta{display:grid;grid-template-columns:repeat(4,minmax(140px,1fr));gap:12px;margin:10px 0 18px}
.agency-mini-stat{background:#f7fafc;border:1px solid var(--line);border-radius:8px;padding:12px}
.agency-mini-stat .label{font-size:12px;color:var(--text-soft);margin-bottom:4px}
.agency-mini-stat .value{font-size:22px;font-weight:800;color:var(--title-dark)}
.agency-item-thumb{width:72px;height:72px;border-radius:8px;object-fit:contain;background:#fff;border:1px solid var(--line);padding:6px;box-shadow:var(--shadow)}

.agency-record-shell{display:flex;flex-direction:column;gap:14px}
.agency-record-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;padding-bottom:14px;border-bottom:1px solid var(--line)}
.agency-record-title h3{margin:0;color:var(--title-dark);font-size:18px}
.agency-record-title p{margin:6px 0 0;color:var(--text-soft);font-weight:600}
.agency-record-switcher{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.agency-record-chip{display:inline-flex;align-items:center;gap:8px;background:#f3f7fb;border:1px solid var(--line);border-radius:999px;padding:8px 12px;font-size:12px;font-weight:800;color:#204b6a}
.agency-master-tabs{display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding-bottom:10px}
.agency-master-tab{border:none;background:transparent;color:#3573a3;font-weight:800;padding:10px 12px;border-radius:10px;cursor:pointer;display:inline-flex;align-items:center;gap:8px}
.agency-master-tab.active{background:#eff7ff;color:#0f67b1;box-shadow:inset 0 -2px 0 #2f8fe8}
.agency-section{display:none}
.agency-section.active{display:block}
.agency-form-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:14px}
.agency-form-grid.two{grid-template-columns:repeat(2,minmax(180px,1fr))}
.agency-form-grid.four{grid-template-columns:repeat(4,minmax(160px,1fr))}
.agency-form-field label{display:block;font-size:12px;font-weight:800;color:#68809a;letter-spacing:.04em;text-transform:uppercase;margin-bottom:6px}
.agency-form-field input,.agency-form-field select,.agency-form-field textarea{width:100%;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;font-size:14px;color:var(--title-dark);outline:none}
.agency-form-field textarea{min-height:90px;resize:vertical}
.agency-form-field.full{grid-column:1/-1}
.agency-form-card{border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden}
.agency-form-card-head{padding:16px 18px;border-bottom:1px solid var(--line);background:#fbfdff}
.agency-form-card-head h4{margin:0;color:var(--title-dark);font-size:16px}
.agency-form-card-head p{margin:6px 0 0;color:var(--text-soft);font-size:13px}
.agency-form-card-body{padding:18px}
.agency-gallery-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:14px}
.agency-gallery-card{border:1px dashed #bdd3e8;border-radius:16px;background:#f8fbff;overflow:hidden;min-height:190px;display:flex;flex-direction:column}
.agency-gallery-preview{flex:1;display:flex;align-items:center;justify-content:center;color:#6f8ca7;background:#eef6fd;font-weight:800;font-size:14px;min-height:130px;padding:16px;text-align:center}
.agency-gallery-card img{width:100%;height:130px;object-fit:cover;display:block}
.agency-gallery-meta{padding:12px 14px}
.agency-gallery-meta strong{display:block;color:var(--title-dark);margin-bottom:4px}
.agency-gallery-meta span{display:block;color:var(--text-soft);font-size:13px}
.agency-flag-grid{display:grid;grid-template-columns:repeat(3,minmax(180px,1fr));gap:14px}
.agency-flag-card{border:1px solid var(--line);border-radius:14px;background:#fff;padding:14px}
.agency-flag-card h5{margin:0 0 10px;color:var(--title-dark);font-size:14px}
.agency-flag-card select,.agency-flag-card input{width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:10px}
.agency-hero-code{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px}
.agency-hero-code span{font-size:12px;font-weight:900;color:#6e8298;letter-spacing:.06em;text-transform:uppercase}
.agency-hero-code strong{display:block;font-size:13px;color:var(--title-dark);letter-spacing:0}
@media (max-width: 980px){
  .agency-form-grid,.agency-form-grid.two,.agency-form-grid.four,.agency-gallery-grid,.agency-flag-grid{grid-template-columns:1fr}
  .agency-record-header{flex-direction:column;align-items:stretch}
}
.serial-chip{font-weight:700;color:var(--text)}
@media (max-width:900px){
  .agency-meta{grid-template-columns:repeat(2,minmax(140px,1fr))}
  .agency-search-box{min-width:100%}
}


.group-color-dot{width:18px;height:18px;border-radius:50%;display:inline-block;border:2px solid rgba(0,0,0,.06)}
.groups-agency-list{max-height:260px;overflow:auto;border:1px solid var(--line);border-radius:12px;padding:10px 12px;background:#fbfcfd}
.group-agency-item{display:flex;align-items:center;justify-content:space-between;padding:10px 6px;border-bottom:1px solid var(--line-soft);gap:10px}
.group-agency-item:last-child{border-bottom:none}
.group-agency-check{display:flex;align-items:center;gap:10px;font-weight:600}
.group-info-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:14px}
.group-detail-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:18px}
.group-detail-card{background:#fff;border:1px solid var(--line);border-radius:12px;padding:16px}
.group-detail-card h4{font-size:14px;color:var(--title-dark);margin-bottom:10px}
.group-inline-meta{display:flex;gap:16px;flex-wrap:wrap;color:var(--text-soft);font-weight:600;margin-top:6px}
.group-inline-meta strong{color:var(--title-dark)}
.group-empty{padding:22px;text-align:center;color:#8a96a4;font-style:italic;font-weight:700}
.group-agency-chip{display:inline-flex;align-items:center;gap:8px;background:#f4f7fa;border:1px solid var(--line);border-radius:999px;padding:6px 10px;font-size:12px;font-weight:700;color:var(--title-dark);margin:0 8px 8px 0}
.group-agency-chip b{font-size:12px;font-weight:950;color:#0b4772;letter-spacing:.03em}.group-agency-chip small{font-size:10px;font-weight:900;color:#6b8297;background:#eaf5fb;border-radius:999px;padding:4px 7px}
.transfer-hidden{display:none !important}
.group-quick-serial{display:grid;grid-template-columns:1fr 120px;gap:10px;align-items:end;margin-bottom:14px}
.group-pending-note{margin-top:6px;font-size:11px;color:#2f8fe8;font-weight:800}



/* ===== Operaciones integrado ===== */
.ops-scope .topbar,
.ops-scope .catalog-topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:18px;
  flex-wrap:wrap;
  margin-bottom:22px;
}

.ops-scope .topbar h2,
.ops-scope .catalog-topbar h2{
  margin:0 0 6px;
  font-size:28px;
  color:var(--title);
}

.ops-scope .topbar p,
.ops-scope .catalog-topbar p{
  margin:0;
  color:var(--text-soft);
}

.ops-scope .stats,
.ops-scope .mini-stats,
.ops-scope .history-highlight{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
  margin-bottom:18px;
}

.ops-scope .stat-card,
.ops-scope .mini-stat,
.ops-scope .panel,
.ops-scope .report-box{
  background:#fff;
  border:1px solid var(--line);
  border-radius:18px;
}

.ops-scope .stat-card{padding:18px}

.ops-scope .stat-card span,
.ops-scope .mini-stat span{
  display:block;
  font-size:13px;
  color:var(--text-soft);
  margin-bottom:8px;
  font-weight:700;
}

.ops-scope .stat-card strong{
  font-size:28px;
  line-height:1;
  color:var(--title-dark);
}

.ops-scope .mini-stat{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:14px 16px;
}

.ops-scope .mini-stat strong{
  font-size:22px;
  line-height:1;
  color:var(--title-dark);
}

.ops-scope .panel{
  overflow:hidden;
  border-radius:26px;
  border:1px solid #d6e7f2;
  background:linear-gradient(180deg,#ffffff 0%,#f9fdff 100%);
  box-shadow:0 18px 42px rgba(15,74,111,.08);
}

.ops-scope .panel-header,
.ops-scope .report-box-header{
  padding:20px 22px;
  border-bottom:1px solid #dbe9f3;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
  background:linear-gradient(180deg,#ffffff 0%,#f7fbff 100%);
}

.ops-scope .panel-header h3,
.ops-scope .report-box-header h4{
  margin:0;
  font-size:20px;
  color:#123d5b;
  font-weight:950;
  letter-spacing:-.01em;
}

.ops-scope .filters{
  display:grid;
  grid-template-columns:1fr 1fr 1.1fr 1.1fr .95fr .95fr;
  gap:13px;
  padding:18px 20px;
  border-bottom:1px solid #dbe9f3;
  background:linear-gradient(180deg,#f8fcff 0%,#f2f8fd 100%);
}

.ops-scope .filters .input,
.ops-scope .filters .select{
  min-height:50px;
  margin:0;
  border-radius:17px !important;
  border:1px solid #cde0ed !important;
  background:#ffffff !important;
  color:#173b57;
  font-size:14px;
  font-weight:750;
  box-shadow:0 8px 18px rgba(15,74,111,.04);
}

.ops-scope .filters .input:focus,
