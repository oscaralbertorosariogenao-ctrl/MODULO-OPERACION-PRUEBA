  display:inline-flex;
  width:12px;
  height:12px;
  border-radius:999px;
  margin-right:10px;
  background:linear-gradient(135deg,#19b7df,#0b6fa4);
  box-shadow:0 0 0 6px rgba(25,183,223,.13);
