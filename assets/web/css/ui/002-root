.modal{z-index:var(--go-z-overlay);background:rgba(6,29,51,.48);backdrop-filter:blur(4px);}
.modal-content,.ops-modal{border-radius:var(--go-radius-modal);border:1px solid var(--go-color-border);box-shadow:var(--go-shadow-floating);}



